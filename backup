#store {
    margin-top: 30px;
    padding: 15px;
    border: 2px solid black;
    width: 250px;
    text-align: center;
}

#store h2 {
    margin-top: 0;
}

body {
    margin: 0;
    font-family: Arial, sans-serif;
    text-align: center; /* centralize everything */
}

#h1 {
    text-align: left;   /* move away from the center */
    margin-left: 20px;  /* move away from the edge */
}

#game, #store {
    margin: 20px auto;
    width: 300px;
}

#mixer {
    position: absolute;
    right: 20px;
    top: 20px;

    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 10px;
}

.volumeControl {
    display: flex;
    align-items: center;
    gap: 10px;
}

#lang {
    position: absolute;
    top: 10px;
    right: 10px;

    border: none;
    background: transparent;
    cursor: pointer;
}

#langBtn img {
    border-radius: 5px;
}

*{
    margin:1;
    padding:1;
    box-sizing:border-box;
}

